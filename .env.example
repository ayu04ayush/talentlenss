# ==============================================================================
# TalentLens Recruitment Platform Environment Configuration
# ==============================================================================

# Application Security
SECRET_KEY=SECRET_KEY=replace_with_a_secure_random_secret
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=10080

# Database Configuration
# Default: SQLite (runs with zero external setup)
# For PostgreSQL: postgresql+psycopg2://user:password@localhost:5432/talentlens
DATABASE_URL=sqlite:///./talentlens.db

# LLM Parser & Evaluation Engine (OPTIONAL)
# If left blank, TalentLens automatically uses its robust built-in rule-based & regex
# fallback parser and deterministic scoring explanation engine with ZERO API keys needed.
GEMINI_API_KEY=
LLM_PROVIDER=gemini

# Email Outreach & Notifications (OPTIONAL)
# If SMTP_DRY_RUN is true or credentials are omitted, emails are recorded in the
# database audit log without sending network requests.
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM_EMAIL=talentlens@company.com
SMTP_DRY_RUN=true

# Storage Settings
UPLOAD_DIR=./uploads

# Frontend URL
NEXT_PUBLIC_API_URL=http://localhost:8000/api
